# MongoDB replica set (required for ledger transactions)
MONGODB_URI=mongodb://localhost:27017/trackopscloud?replicaSet=rs0
# MONGODB_DB_NAME=trackopscloud

# NextAuth v4. Set NEXTAUTH_URL to the deployed canonical URL in production.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
# AUTH_SECRET is an accepted alias; if both are set, use the same value.
# AUTH_SECRET=replace-with-the-same-secret

# Public application settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_CONTACT_EMAIL=contact@your-domain.com
NEXT_PUBLIC_PLATFORM_SUPPORT_EMAIL=support@your-domain.com

# One-time seed values
PLATFORM_ADMIN_SEED_EMAIL=admin@your-domain.com
PLATFORM_ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# Gmail SMTP app password and verified sender
GMAIL_SMTP_EMAIL=sender@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM=sender@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB-backed rate limit settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
